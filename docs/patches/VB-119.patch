   spare(11); check(posts(cal(1, 0)).length === 2, 'two trips under 12 days of spare food');
   spare(0); check(near(K.urgency(st, j, cal(1, 0), MATCH.urgency), 2), 'urgency 2 at none');
-  const meals = hh.meals, s = F.stock(st, g.water);
